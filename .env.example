# ============================================================================
# Intelligent Book Management System - Environment Configuration
# ============================================================================
# Copy this file to .env and configure for your environment
# IMPORTANT: Never commit .env with real secrets to version control!
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# For SQLite (local development):
DATABASE_URL=sqlite+aiosqlite:///:memory:

# For PostgreSQL (production/docker) - uncomment and configure:
# DATABASE_URL=postgresql+asyncpg://book_user:book_pass@postgres:5432/books_db
POSTGRES_DB=books_db
POSTGRES_USER=book_user
POSTGRES_PASSWORD=book_pass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================================================
# JWT / Security Configuration (CRITICAL)
# ============================================================================
# NEVER use the default value in production!
# Generate a strong secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-key-change-in-production-use-32-char-minimum

# JWT algorithm for token signing
JWT_ALGORITHM=HS256

# JWT token expiration time (in days)
JWT_EXPIRE_DAYS=7

# ============================================================================
# Application Settings
# ============================================================================
# Set to "development" or "production"
ENVIRONMENT=development

# Enable debug logging
DEBUG=true

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Application port
PORT=8000

# ============================================================================
# AI/LLM Configuration (Critical for reliability)
# ============================================================================
# Ollama endpoint URL
OLLAMA_ENDPOINT=http://ollama:11434

# Model to use for AI summaries
OLLAMA_MODEL=mistral

# Max seconds to wait for AI summary generation before timeout
AI_SUMMARY_TIMEOUT=30

# Max retries for failed AI operations
AI_MAX_RETRIES=2

# Retry backoff multiplier (exponential backoff)
AI_BACKOFF_FACTOR=2.0

# ============================================================================
# Redis Configuration (Optional - for caching)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================================
# CORS Configuration
# ============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ============================================================================
# Application Performance
# ============================================================================
# Max concurrent requests
MAX_WORKERS=4

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# JWT & SECURITY CONFIGURATION
# ============================================================================
# Generate a strong secret key in production (e.g., openssl rand -hex 32)
# CRITICAL: Never commit the actual SECRET_KEY to version control
SECRET_KEY=your_super_secret_key_here_change_in_production

# JWT algorithm (HS256 is recommended for symmetric key signing)
JWT_ALGORITHM=HS256

# JWT token expiration time in hours
TOKEN_EXPIRE_HOURS=24

# ============================================================================
# OLLAMA AI SERVICE CONFIGURATION
# ============================================================================
# Ollama API endpoint (local or remote)
OLLAMA_URL=http://localhost:11434/api/generate

# Model to use (must be installed on Ollama)
OLLAMA_MODEL=llama3:8b

# Request timeout in seconds (increase if model takes longer to respond)
OLLAMA_TIMEOUT=120

# Number of retry attempts for failed requests
OLLAMA_RETRIES=3

# Exponential backoff multiplier (base delay = OLLAMA_BACKOFF * 2^(attempt-1))
OLLAMA_BACKOFF=1

# ============================================================================
# TOKEN AND GENERATION LIMITS (prevent runaway tokens and costs)
# ============================================================================
# Maximum tokens to generate per request (typical summaries: 256-512)
OLLAMA_MAX_TOKENS=512

# Minimum tokens expected in response (fallback triggered if shorter)
OLLAMA_MIN_TOKENS=100

# Maximum context window size (total tokens available for model)
# Llama 3: 8192 tokens, Llama 2: 4096 tokens
OLLAMA_MAX_CONTEXT=4096

# ============================================================================
# MODEL BEHAVIOR PARAMETERS (affect generation quality and speed)
# ============================================================================
# Temperature: 0.0 (deterministic/repetitive) to 1.0 (creative/random)
# Recommended: 0.3-0.7 for summaries, 0.7-1.0 for creative content
OLLAMA_TEMPERATURE=0.7

# Top-P (nucleus sampling): 0.0-1.0, higher = more diverse
# Recommended: 0.7-0.95
OLLAMA_TOP_P=0.9

# Top-K (top-k sampling): select from top K most likely tokens
# Recommended: 20-50
OLLAMA_TOP_K=40

# Repeat penalty: 1.0 (no penalty) to 2.0 (strong penalty for repetition)
# Recommended: 1.0-1.5 to avoid repetitive outputs
OLLAMA_REPEAT_PENALTY=1.1

# ============================================================================
# REDIS CACHE CONFIGURATION
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ============================================================================
# POSTGRES DOCKER ENVIRONMENT (for docker-compose)
# ============================================================================
POSTGRES_DB=books_db
POSTGRES_USER=book_user
POSTGRES_PASSWORD=book_pass

# ============================================================================
# APPLICATION ENVIRONMENT
# ============================================================================
ENVIRONMENT=development
DEBUG=true
