# For SQLite (local development):
DATABASE_URL=sqlite+aiosqlite:///:memory:

# ============================================================================
# JWT / Security Configuration
# ============================================================================
# CRITICAL: Generate a strong secret key for production
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_super_secret_key_here_change_in_production

# JWT algorithm (HS256, RS256, etc.)
JWT_ALGORITHM=HS256

# Token expiration time in hours
TOKEN_EXPIRE_HOURS=1

# ============================================================================
# Ollama AI Service Configuration
# ============================================================================
# Ollama endpoint (including /api/generate path)
OLLAMA_URL=http://localhost:11434/api/generate

# Model to use (ensure it's installed in Ollama)
# Options: llama3:8b, mistral, neural-chat, etc.
OLLAMA_MODEL=llama3:8b

# Timeout for Ollama requests (seconds)
OLLAMA_TIMEOUT=120

# Number of retries for Ollama requests
OLLAMA_RETRIES=3

# Backoff multiplier for retries (exponential)
OLLAMA_BACKOFF=1

# ============================================================================
# Redis Cache Configuration
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ============================================================================
# Application Settings
# ============================================================================
# Set to "development" or "production"
ENVIRONMENT=development

# Enable debug logging
DEBUG=true

# ============================================================================
# AI/LLM Configuration (Critical for reliability)
# ============================================================================
# Max seconds to wait for AI summary generation before timeout
AI_SUMMARY_TIMEOUT=30

# Max retries for failed AI operations
AI_MAX_RETRIES=2

# Retry backoff multiplier (exponential backoff)
AI_BACKOFF_FACTOR=2.0

# ============================================================================
# Docker Compose (if using docker-compose.yml)
# ============================================================================
# These are used by docker-compose.yml for PostgreSQL
POSTGRES_DB=books_db
POSTGRES_USER=book_user
POSTGRES_PASSWORD=book_pass
